@model QuaMonBa_Store.ViewComponentModels.KhachhangVM

<section class="h-100 ">
    <div class="container py-5 h-100">
        <div class="row d-flex justify-content-center align-items-center h-90">
            <div class="col">
                <div class="card card-registration my-4">
                    <div class="row g-0">
                        <div class="col-xl-6 d-none d-xl-block">
                            <img src="https://mdbcdn.b-cdn.net/img/Photos/new-templates/bootstrap-registration/img4.webp"
                                 alt="Sample photo"
                                 class="img-fluid w-100 h-100"
                                 style="object-fit: cover; border-top-left-radius: .25rem; border-bottom-left-radius: .25rem;" />
                        </div>
                        <div class="col-xl-6">
                            <div class="card-body p-md-5 text-black">
                                <h3 class="mb-5 text-uppercase">registration form</h3>
                                <form asp-action="Dangky">
                                    <div class="row">
                                        <div class="col-md-6 mb-4">
                                            <div data-mdb-input-init class="form-outline">
                                                <label asp-for="@Model.MaKh" class="form-label">Name account</label>
                                                <input type="text" asp-for="@Model.MaKh" class="form-control form-control-lg" />
                                                <span asp-validation-for="@Model.MaKh" class="text-danger"></span>
                                            </div>
                                        </div>
                                        <div class="col-md-6 mb-4">
                                            <label asp-for="@Model.HoTen" class="form-label">Full Name</label>
                                            <input type="text" asp-for="@Model.HoTen" class="form-control form-control-lg" />
                                            <span asp-validation-for="@Model.HoTen" class="text-danger"></span>
                                        </div>
                                    </div>

                                    <div data-mdb-input-init class="form-outline mb-4">
                                        <label asp-for="@Model.DiaChi" class="form-label">Adress ID</label>
                                        <input type="text" asp-for="@Model.DiaChi" class="form-control form-control-lg" />
                                        <span asp-validation-for="@Model.DiaChi" class="text-danger"></span>
                                    </div>
                                    <div data-mdb-input-init class="form-outline mb-4">
                                        <label asp-for="@Model.NgaySinh" class="form-label">Date of Birth</label>
                                        <input type="date" asp-for="@Model.NgaySinh" class="form-control form-control-lg" />
                                        <span asp-validation-for="@Model.NgaySinh" class="text-danger"></span>
                                    </div>
                                    <div class="d-md-flex justify-content-start align-items-center mb-4 py-2">
                                        <h6 class="mb-0 me-4">Gender: </h6>

                                        <!-- Nữ (True) -->
                                        <div class="form-check form-check-inline mb-0 me-4">
                                            <input class="form-check-input" type="radio" asp-for="@Model.GioiTinh" id="femaleGender" value="true" />
                                            <label class="form-check-label" asp-for="@Model.GioiTinh" >Nữ</label>
                                        </div>

                                        <!-- Nam (False) -->
                                        <div class="form-check form-check-inline mb-0 me-4">
                                            <input class="form-check-input" type="radio" asp-for="@Model.GioiTinh" id="maleGender" value="false" />
                                            <label class="form-check-label" asp-for="@Model.GioiTinh" >Nam</label>
                                        </div>
                                    </div>

                                    <div data-mdb-input-init class="form-outline mb-4">
                                        <label asp-for="@Model.DienThoai" class="form-label">Phone Number</label>
                                        <input type="text" asp-for="@Model.DienThoai" class="form-control form-control-lg" />
                                        <span asp-validation-for="@Model.DienThoai" class="text-danger"></span>
                                    </div>

                                    <div data-mdb-input-init class="form-outline mb-4">
                                        <label asp-for="@Model.Email" class="form-label">Email ID</label>
                                        <input type="text" asp-for="@Model.Email" class="form-control form-control-lg" />
                                        <span asp-validation-for="@Model.Email" class="text-danger"></span>
                                    </div>
                                    <div data-mdb-input-init class="form-outline mb-4">
                                        <label asp-for="@Model.MatKhau" class="form-label">Password</label>
                                        <input type="password" asp-for="@Model.MatKhau" class="form-control form-control-lg" />
                                        <span asp-validation-for="@Model.MatKhau" class="text-danger"></span>
                                    </div>
                                    <button type="button" id="btnSwitchToLogin" class="btn btn-outline-primary mb-3">I already have an account</button>
                                    <div class="d-flex justify-content-end pt-3">
                                        <button type="reset" data-mdb-button-init data-mdb-ripple-init class="btn btn-light btn-lg">Reset all</button>
                                        <button type="submit" data-mdb-button-init data-mdb-ripple-init class="btn btn-warning btn-lg ms-2">Submit form</button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>