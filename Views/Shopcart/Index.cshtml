@model IEnumerable<QuaMonBa_Store.data.GioHang>
@{
    ViewData["Title"] = "Giỏ Hàng";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- Single Page Header start -->
<div class="container-fluid bg-primary hero-header mb-5">
    <div class="container text-center">
        <h1 class="display-4 text-white mb-3 animated slideInDown">Giỏ Hàng</h1>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb justify-content-center mb-0 animated slideInDown">
                <li class="breadcrumb-item"><a class="text-white" href="/">Home</a></li>
                <li class="breadcrumb-item"><a class="text-white" href="#">Pages</a></li>
                <li class="breadcrumb-item"><a class="text-white" href="/Product/Index">Products</a></li>
            </ol>
        </nav>
    </div>
</div>
<!-- Single Page Header End -->
<!-- Cart Page Start -->
<div class="container-fluid py-5">
    <div class="container py-5">
        
        @if (Model == null || !Model.Any())
        {
            <!-- HIỂN THỊ KHI GIỎ HÀNG TRỐNG -->
            <div class="text-center py-5">
                <h3 class="text-muted">Giỏ hàng của bạn đang trống!</h3>
                <a href="/Product" class="btn btn-primary rounded-pill py-2 px-4 mt-3">Tiếp tục mua sắm</a>
            </div>
        }
        else
        {
            var tongTien = Model.Sum(x => x.ThanhTien);
            <div class="table-responsive">
                <table class="table">
                    <thead>
                        <tr>
                            <th scope="col">Products</th>
                            <th scope="col">Name</th>
                            <th scope="col">Price</th>
                            <th scope="col">Quantity</th>
                            <th scope="col">Total</th>
                            <th scope="col">Handle</th>
                        </tr>
                    </thead>
                    <tbody>
                        <!-- VÒNG LẶP FOREACH TẠO TỰ ĐỘNG CÁC DÒNG SẢN PHẨM -->
                        @foreach (var item in Model)
                        {
                            <tr>
                                <th scope="row">
                                    <div class="d-flex align-items-center">
                                        <!-- Gọi ảnh từ thư mục, thêm thuộc tính chống lỗi ảnh -->
                                        <img src="~/img/@item.Hinh" class="img-fluid me-5 rounded-circle" style="width: 80px; height: 80px; object-fit: cover;" alt="@item.TenHH" onerror="this.onerror=null; this.src='https://via.placeholder.com/80?text=No+Image';">
                                    </div>
                                </th>
                                <td>
                                    <!-- Hiển thị Tên Sản Phẩm -->
                                    <p class="mb-0 mt-4">@item.TenHH</p>
                                </td>
                                <td>
                                    <!-- Hiển thị Đơn Giá -->
                                    <p class="mb-0 mt-4">@item.DonGia.ToString("#,##0") đ</p>
                                </td>
                                <td>
                                    <div class="input-group quantity mt-4" style="width: 100px;">
                                        <div class="input-group-btn">
                                            <button class="btn btn-sm btn-minus rounded-circle bg-light border">
                                                <i class="fa fa-minus"></i>
                                            </button>
                                        </div>
                                        <!-- Hiển thị Số Lượng -->
                                        <input type="text" class="form-control form-control-sm text-center border-0" value="@item.SoLuong" readonly>
                                        <div class="input-group-btn">
                                            <button class="btn btn-sm btn-plus rounded-circle bg-light border">
                                                <i class="fa fa-plus"></i>
                                            </button>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <!-- Hiển thị Thành Tiền -->
                                    <p class="mb-0 mt-4">@item.ThanhTien.ToString("#,##0") đ</p>
                                </td>
                                <td>
                                    <!-- Nút Xóa Sản Phẩm -->
                                    <a asp-controller="Shopcart" asp-action="RemoveCartItem" asp-route-id="@item.MaHH" class="btn btn-md rounded-circle bg-light border mt-4">
                                        <i class="fa fa-times text-danger"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="mt-5">
                <input type="text" class="border-0 border-bottom rounded me-5 py-3 mb-4" placeholder="Coupon Code">
                <button class="btn border-primary rounded-pill px-4 py-3 text-primary" type="button">Apply Coupon</button>
            </div>

           
               
            

            <div class="row g-4 justify-content-end">
                <div class="col-8"></div>
                <div class="col-sm-8 col-md-7 col-lg-6 col-xl-4">
                    <div class="bg-light rounded">
                        <div class="p-4">
                            <h1 class="display-6 mb-4">Cart <span class="display-6 mb-4">Total</span></h1>
                            <div class="d-flex justify-content-between mb-4">
                                <h5 class="mb-0 me-4">Subtotal:</h5>
                                <!-- Hiển thị Tổng Tiền Tạm Tính -->
                                <p class="mb-0">@tongTien.ToString("#,##0") đ</p>
                            </div>
                            <div class="d-flex justify-content-between">
                                <h5 class="mb-0 me-4">Shipping</h5>
                                <div class="">
                                    <p class="mb-0">Flat rate: 0 đ</p>
                                </div>
                            </div>
                            <p class="mb-0 text-end">Shipping to Vietnam.</p>
                        </div>
                        <div class="py-4 mb-4 border-top border-bottom d-flex justify-content-between">
                            <h5 class="mb-0 ps-4 me-4">Total</h5>
                            <!-- Hiển thị Tổng Tiền Cuối Cùng -->
                            <p class="mb-0 pe-4 text-primary fw-bold fs-5">@tongTien.ToString("#,##0") đ</p>
                        </div>
                        <a href="/Checkout" class="btn btn-primary rounded-pill px-4 py-3 text-white text-uppercase mb-4 ms-4 w-75 text-center">Proceed Checkout</a>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
<!-- Cart Page End -->