@model IEnumerable<QuaMonBa_Store.ViewComponentModels.HangHoaVM>
<div class="container-fluid py-5">
    <div class="container">
        <div class="mx-auto text-center wow fadeIn" data-wow-delay="0.1s" style="max-width: 600px;">
            <h1 class="text-primary mb-3"><span class="fw-light text-dark">Our Natural</span> Hair Products</h1>
            <p class="mb-5">Lorem ipsum dolor sit amet, consectetur adipiscing elit.</p>
        </div>
        <input type="text" id="txtTimKiem" class="form-control mb-4" placeholder="Tìm kiếm dầu gội, kem dưỡng...">
        <div class="row g-5">
            <div class="col-lg-3 wow fadeIn" data-wow-delay="0.1s">
                <div class="sidebar-item border p-4 mb-4">
                    <h4 class="text-primary mb-4">Loại sản phẩm</h4>
                    <div  class="list-group list-group-flush">
                        @await Component.InvokeAsync("MenuLoai")
                    </div>
                </div>

                <div class="sidebar-item border p-4">
                    <h4 class="text-primary mb-4">Lọc theo giá</h4>

                    <!-- Thêm min, max, step và value mặc định -->
                    <!-- Giả sử giá cao nhất là 5 triệu, mỗi lần kéo thụt 50k -->
                    <input type="range" class="form-range" id="priceRange" min="0" max="200000" step="100" value="200000">

                    <div class="d-flex justify-content-between mt-2">
                        <span class="text-muted">0 đ</span>
                        <!-- Chỗ này để hiển thị số tiền nhảy liên tục khi kéo -->
                        <span id="giaHienThi" class="fw-bold text-danger">200,000 đ</span>
                    </div>
                </div>
            </div>

            <div class="col-lg-9">

                <!-- 1. KHUNG NÀY ĐỂ AJAX ĐÈ KẾT QUẢ TÌM KIẾM / LỌC GIÁ VÀO -->
                <div class="row g-4" id="khung-chua-san-pham">
                    <!-- Render mặc định lúc mới vào web -->
                    <partial name="_list_product" model="Model" />
                </div>

                <!-- 2. THANH PHÂN TRANG NẰM TRÁNH RA NGOÀI ĐỂ KHÔNG BỊ XÓA -->
                <div class="col-12 mt-5">
                    <div class="pagination d-flex justify-content-center">
                            @if (ViewBag.TotalPages > 1)
                            {
                                int total = ViewBag.TotalPages;
                                int current = ViewBag.CurrentPage;
                                int limit = 1; // Số trang hiển thị quanh trang hiện tại

                                @* Nút Quay lại trang 1 nếu đang ở xa đầu trang *@
                                if (current > limit + 1)
                                {
                                    <a asp-action="Index" asp-route-maloai="@ViewBag.MaLoai" asp-route-page="1" class="rounded btn-light" style="padding: 10px 15px; margin: 0 5px; border: 1px solid #ddd;">1</a>
                                    if (current > limit + 2)
                                    {
                                        <span style="padding: 10px 5px;">...</span>
                                    }
                                }

                                @* Vòng lặp hiển thị các trang chính *@
                                @for (int i = Math.Max(1, current - limit); i <= Math.Min(total, current + limit); i++)
                                {
                                    <a asp-action="Index"
                                       asp-route-maloai="@ViewBag.MaLoai"
                                       asp-route-page="@i"
                                       class="rounded @(current == i ? "active btn-primary text-white" : "btn-light")"
                                       style="padding: 10px 15px; margin: 0 5px; border: 1px solid #ddd;">
                                        @i
                                    </a>
                                }

                                @* Nút nhảy đến trang cuối nếu đang ở xa cuối trang *@
                                if (current < total - limit)
                                {
                                    if (current < total - limit - 1)
                                    {
                                        <span style="padding: 10px 5px;">...</span>
                                    }
                                    <a asp-action="Index" asp-route-maloai="@ViewBag.MaLoai" asp-route-page="@total" class="rounded btn-light" style="padding: 10px 15px; margin: 0 5px; border: 1px solid #ddd;">@total</a>
                                }
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
