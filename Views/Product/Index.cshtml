
@{
    ViewData["Title"] = "Product";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

    <!-- Hero Start -->
  <partial name="_hero" />
    <!-- Hero End -->

    <!-- Product Start -->
<partial name="_Show_product" model="Model" />
<!-- Product End -->

    <!-- Newsletter Start -->
    <div class="container-fluid newsletter bg-primary py-5 my-5">
        <div class="container py-5">
            <div class="mx-auto text-center wow fadeIn" data-wow-delay="0.1s" style="max-width: 600px;">
                <h1 class="text-white mb-3"><span class="fw-light text-dark">Let's Subscribe</span> The Newsletter</h1>
                <p class="text-white mb-4">Subscribe now to get 30% discount on any of our products</p>
            </div>
            <div class="row justify-content-center">
                <div class="col-md-7 wow fadeIn" data-wow-delay="0.5s">
                    <div class="position-relative w-100 mt-3 mb-2">
                        <input class="form-control w-100 py-4 ps-4 pe-5" type="text" placeholder="Enter Your Email"
                               style="height: 48px;">
                        <button type="button" class="btn shadow-none position-absolute top-0 end-0 mt-1 me-2">
                            <i class="fa fa-paper-plane text-white fs-4"></i>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>


<div class="modal fade" id="modalSuaSanPham" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-sm modal-dialog-centered">

        <div class="modal-content shadow-lg" id="khung-chua-form-sua" style="border: 2px solid #848884;">
        </div>

    </div>
</div>
@section Scripts
{
    <script>
        $(document).ready(function () {
            // In ra dòng này để chắc chắn Javascript đã được nạp
            console.log("✅ JAVASCRIPT ĐÃ LOAD THÀNH CÔNG!");

            var typingTimer;
            var doneTypingInterval = 500;

            // 1. TÌM KIẾM
            $(document).on('keyup', '#txtTimKiem', function () {
                clearTimeout(typingTimer);
                var chuVuaGo = $(this).val();
                console.log("👉 Đang tìm kiếm từ khóa: ", chuVuaGo);

                typingTimer = setTimeout(function () {
                    $.ajax({
                        url: '@Url.Action("TimKiemSP", "Product")', // Dùng Razor sinh link chuẩn 100%
                        type: 'GET',
                        data: { tuKhoa: chuVuaGo },
                        beforeSend: function () {
                            $('#khung-chua-san-pham').css({ 'opacity': '0.4', 'pointer-events': 'none' });
                        },
                        success: function (htmlKetQua) {
                            console.log("✅ Dữ liệu tìm kiếm trả về thành công!");
                            $('#khung-chua-san-pham').html(htmlKetQua);
                        },
                        complete: function () {
                            $('#khung-chua-san-pham').css({ 'opacity': '1', 'pointer-events': 'auto' });
                        },
                        error: function (xhr, status, error) {
                            console.error("❌ LỖI TÌM KIẾM AJAX: ", error);
                            console.error("Chi tiết lỗi: ", xhr.responseText);
                        }
                    });
                }, doneTypingInterval);
            });

            // 2. HIỂN THỊ SỐ TIỀN KHI KÉO
            $(document).on('input', '#priceRange', function () {
                var giaTriHienTai = $(this).val();
                $('#giaHienThi').text(Number(giaTriHienTai).toLocaleString('vi-VN') + " đ");
            });

            // 3. LỌC THEO GIÁ
            $(document).on('change', '#priceRange', function () {
                var mucGiaChon = $(this).val();
                console.log("👉 Đang lọc giá: ", mucGiaChon);

                $.ajax({
                    url: '@Url.Action("LocTheoGia", "Product")', // Dùng Razor sinh link chuẩn 100%
                    type: 'GET',
                    data: { giaTien: mucGiaChon },
                    beforeSend: function () {
                        $('#khung-chua-san-pham').css({ 'opacity': '0.4', 'pointer-events': 'none' });
                    },
                    success: function (htmlKetQua) {
                        console.log("✅ Dữ liệu lọc giá trả về thành công!");
                        $('#khung-chua-san-pham').html(htmlKetQua);
                    },
                    complete: function () {
                        $('#khung-chua-san-pham').css({ 'opacity': '1', 'pointer-events': 'auto' });
                    },
                    error: function (xhr, status, error) {
                        console.error("❌ LỖI LỌC GIÁ AJAX: ", error);
                        console.error("Chi tiết lỗi: ", xhr.responseText);
                    }
                });
            });
        });

        // HÀM MỞ FORM SỬA (Giữ nguyên)
        function moFormSua(id) {
            $.ajax({
                url: '/Product/Edit/' + id,
                type: 'GET',
                success: function (data) {
                    $('#khung-chua-form-sua').html(data);
                    var myModal = new bootstrap.Modal(document.getElementById('modalSuaSanPham'));
                    myModal.show();
                },
                error: function () {
                    alert("Không thể tải form sửa!");
                }
            });
        }
    </script>
}