@model IEnumerable<QuaMonBa_Store.ViewComponentModels.HangHoaVM>
@foreach (var item in Model)
{
    <div class="col-md-6 col-lg-4 wow fadeIn" data-wow-delay="0.1s">
        <div class="product-item text-center border h-100 p-4 position-relative">

            <img class="img-fluid mb-4" src="~/img/shampoo.png" alt="">

            <div class="position-absolute bg-warning text-white px-3 py-1 rounded" style="top: 10px; left: 10px;">
                @item.TenLoai
            </div>

            <div class="mb-2">
                <small class="fa fa-star text-primary"></small>
                <small class="fa fa-star text-primary"></small>
                <small class="fa fa-star text-primary"></small>
                <small class="fa fa-star text-primary"></small>
                <small class="fa fa-star text-primary"></small>
                <small>(99)</small>
            </div>
            <!-- Code mới đã sửa -->
            <a asp-controller="SingleProduct" asp-action="Index" asp-route-id="@item.MaHH" class="h6 d-inline-block mb-2">
                @item.TenHH
            </a>           
            <h5 class="text-primary mb-3">@item.DonGia VNĐ</h5>

            @if (User.IsInRole("Admin"))
            {
                <div class="btn-group">
                    <button href="javascript:void(0)"
                       class="btn btn-warning"
                       onclick="moFormSua(@item.MaHH)">
                        <i class="fas fa-edit"></i> Sửa
                    </button>
                    <a asp-controller="Product" asp-action="Delete" asp-route-id="@item.MaHH" class="btn btn-danger"
                       onclick="return confirm('Bạn có chắc chắn muốn xóa?')">
                        <i class="fas fa-trash"></i> Xóa
                    </a>
                </div>
            }
            else
            {
                <a asp-controller="Shopcart" asp-action="AddToCart" asp-route-id="@item.MaHH" class="btn btn-outline-primary px-3">
                    <i class="fas fa-shopping-cart"></i> Add To Cart
                </a>
            }
        </div>
    </div>
}